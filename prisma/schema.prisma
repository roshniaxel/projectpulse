generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Integration connections per user
  integrations  UserIntegration[]

  // Time tracking
  timeEntries           TimeEntry[]
  toolSessions          ToolSession[]
  autoPushClaudeTime    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Per-User Integration Connections ───────────────────────────────────────

model UserIntegration {
  id          String  @id @default(cuid())
  userId      String
  source      String  // "jira" | "slack" | "google_calendar" | "zoom" | "mavenlink" | "granola"
  connected   Boolean @default(false)
  accessToken String? // Encrypted token for the integration
  metadata    Json?   // Extra config (e.g. Jira cloudId, Slack workspace, etc.)

  connectedAt DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
}

// ─── Time Tracking ──────────────────────────────────────────────────────────

// A single block of time attributable to a user + source (+ optional ticket).
// Created when a ToolSession ends, or when auto-detection surfaces an entry
// from Zoom / Slack / Calendar / Jira. Goes through draft → approved → logged.
model TimeEntry {
  id            String   @id @default(cuid())
  userId        String
  source        String   // "claude_code" | "jira" | "zoom" | "slack" | "google_calendar" | "mavenlink"
  ticketKey     String?  // e.g. "RGU-224"; null for non-ticket time
  description   String?
  startedAt     DateTime
  endedAt       DateTime
  durationSec   Int
  status        String   @default("draft") // "draft" | "approved" | "logged" | "rejected"
  jiraWorklogId String?  // Set once pushed to Jira

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, ticketKey])
  @@index([userId, status])
}

// Live aggregate of tool-call ticks for an in-progress Claude Code session.
// One row per (user, ticket) work session. Materializes into a TimeEntry on stop.
model ToolSession {
  id            String   @id @default(cuid())
  userId        String
  tool          String   // "claude_code" (extensible to other live-tracked tools)
  ticketKey     String?
  description   String?
  activeSeconds Int      @default(0)
  ticks         Json     // [unix_ts, ...] — append-only list of tool-call timestamps
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
}

// Cached Jira ticket metadata so we can check estimates / show summaries
// without round-tripping to Jira on every request.
model JiraTicketCache {
  key             String   @id // e.g. "RGU-224"
  summary         String
  estimateSec     Int?     // timeoriginalestimate in seconds; null = no estimate
  assigneeEmail   String?
  status          String?
  lastSyncedAt    DateTime @default(now())

  @@index([assigneeEmail])
}
